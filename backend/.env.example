ENV=development
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite — works out of the box for local dev, no extra services needed
DATABASE_URL=sqlite:///./wholesale.db

# Neon PostgreSQL (production) — get this from your Neon project dashboard:
#   neon.tech → your project → Connection Details → copy the "Connection string"
#   It looks like: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# IMPORTANT: the ?sslmode=require at the end is mandatory for Neon — do not remove it.

SECRET_KEY=change-me-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:8000"]

# Email configuration (optional - leave empty for console logging in dev)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@wholesale-marketplace.com
MAIL_FROM_NAME=Wholesale Marketplace
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=true
MAIL_SSL=false

# Frontend URL for email verification links
FRONTEND_BASE_URL=http://localhost:8000
